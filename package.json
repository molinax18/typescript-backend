{
  "name": "backend-typescript",
  "version": "1.0.0",
  "description": "Practicando Backend con TypeScript",
  "license": "ISC",
  "author": "Ariel Molina",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node ./dist/main.js",
    "dev": "nodemon --watch src/** --ext ts,json --ignore src/**/*.spec.ts --exec ts-node src/main.ts",
    "lint": "npx eslint .",
    "format": "npx prettier ./src/ --write",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "mongoose": "9.9.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
